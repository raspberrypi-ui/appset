msgid "Desktop"
msgstr "デスクトップ"

#: src/pipanel.c:356
msgctxt "tab"
msgid "Taskbar"
msgstr "タスクバー"

#: src/pipanel.c:357
msgctxt "tab"
msgid "Theme"
msgstr "テーマ"

#: src/pipanel.c:358
msgctxt "tab"
msgid "Defaults"
msgstr "デフォルト"

#: src/pipanel.c:359
msgctxt "tab"
msgid "Dock"
msgstr "Dock"

#: src/pipanel.c:360
