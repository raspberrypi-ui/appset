#: data/pipanel.ui:495
msgid "Large (32x32)"
msgstr "დიდი (32x32)"

#: data/pipanel.ui:496
msgid "Medium (24x24)"
msgstr "საშუალო (24x24)"

#: data/pipanel.ui:497
msgid "Small (16x16)"
msgstr "პატარა (16x16)"

#: data/pipanel.ui:526
msgid "Position"
msgstr "პოზიცია"

#: data/pipanel.ui:537
msgid "Top"
msgstr "ზედა"

