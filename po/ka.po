#: src/pipanel.c:615 src/defaults.c:630 src/system.c:1246
msgid ""
"The theme for Geany cannot be changed while it is open.\n"
"Please close it and try again."
msgstr ""
"Geany-ის თემის შეცვლა შეუძლებელია, სანამ ის ღიაა.\n"
"დახურეთ ის და კიდევ სცადეთ."

#: src/pipanel.c:621 src/defaults.c:636 src/system.c:1256
msgid ""
"The theme for Calculator cannot be changed while it is open.\n"
"Please close it and try again."
msgstr ""
"კალკულატორის თემას ვერ შეცვლით, სანამ ის ღიაა.\n"
"დახურეთ ის და კიდევ სცადეთ."

#: src/pipanel.c:625
msgid "Restoring configuration - please wait..."
msgstr "კონფიგურაციის აღდგენა - მოითმინეთ..."

#: src/pipanel.c:703
msgid "Loading configuration - please wait..."
msgstr "კონფიგურაციის ჩატვირთვა - მოითმინეთ..."

#: data/pipanel.ui:9 data/pipanel.ui:1355 data/pipanel.desktop.in:3
msgid "Appearance Settings"
msgstr "გარეგნობის პარამეტრები"

#: data/pipanel.ui:38
msgid "Desktop Number"
msgstr "სამუშაო მაგიდის ნომერი"

#: data/pipanel.ui:51
msgid "Choose the desktop to configure"
msgstr "აირჩიეთ მოსარგები სამუშაო მაგიდა"

#: data/pipanel.ui:65
msgid "Show identical desktop on second monitor"
msgstr "იდენტური სამუშაო მაგიდის ჩვენება მეორე ეკრანზე"

#: data/pipanel.ui:69
msgid "Check this box to show the same desktop image and icons on both monitors"
msgstr "დასვით ეს თოლია იგივე სამუშაო მაგიდის სურათისა და ხატულების საჩვენებლად ორივე მონიტორზე"

#: data/pipanel.ui:95
msgid "Layout"
msgstr "განლაგება"

#: data/pipanel.ui:108
msgid "Set how the wallpaper should be fitted to the screen"
msgstr "დააყენეთ, როგორ ხდება ფონის სურათის ჩატევა ეკრანზე"

#: data/pipanel.ui:110
msgid "No image"
msgstr "გამოსახულების გარეშე"

#: data/pipanel.ui:111
msgid "Centre image on screen"
msgstr "გამოსახულების დაცენტრება ეკრანზე"

#: data/pipanel.ui:112
msgid "Fit image onto screen"
msgstr "გამოსახულების ჩატევა ეკრანზე"

#: data/pipanel.ui:113
msgid "Fill screen with image"
msgstr "ეკრანის შევსება გამოსაუხლებით"

#: data/pipanel.ui:114
msgid "Stretch to cover screen"
msgstr "გაწელვა ეკრანის შესავსებად"

#: data/pipanel.ui:115
msgid "Tile image"
msgstr "მოზაიკური გამოსახულება"

#: data/pipanel.ui:144
msgid "Picture"
msgstr "სურათი"

#: data/pipanel.ui:157
msgid "Choose image file to use as wallpaper"
msgstr "აირჩიეთ ფონის გამოსახულების ფაილი"

#: data/pipanel.ui:181 data/pipanel.ui:590
msgid "Colour"
msgstr "ფერი"

#: data/pipanel.ui:195
msgid "Choose the colour of the desktop background"
msgstr "აირჩიეთ სამუშაო მაგიდის ფონის ფერი"

#: data/pipanel.ui:222 data/pipanel.ui:631
msgid "Text Colour"
msgstr "ტექსტის ფერი"

#: data/pipanel.ui:236
msgid "Choose the colour of the text used for desktop icon labels"
msgstr "აირჩიეთ სამუშაო მაგიდის ხატულას ჭდეებზე გამოყენებული ფერი"

#: data/pipanel.ui:263
msgid "Desktop Folder"
msgstr "სამუშაო მაგიდის საქაღალდე"

#: data/pipanel.ui:276
msgid "Choose the folder containing files to be shown on the second desktop"
msgstr "აირჩიეთ ფაილების შემცველი საქაღალდე მეორე ეკრანზე საჩვენებლად"

