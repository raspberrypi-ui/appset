msgid "Show Home Folder"
msgstr "საწყისი საქაღალდის ჩვენება"

#: data/pipanel.ui:322
msgid "Show the current user's home folder on the desktop"
msgstr "მიმდინარე მომხმარებლის საწყისი საქაღალდის ჩვენება სამუშაო მაგიდაზე"

#: data/pipanel.ui:356
msgid "Show Wastebasket"
msgstr "ნაგვის ყუთის ჩვენება"

#: data/pipanel.ui:374
msgid "Show the wastebasket on the desktop"
msgstr "ნაგვის ყუთის ჩვენება სამუშაო მაგიდაზე"

#: data/pipanel.ui:408
msgid "Show Mounted Disks"
msgstr "მიმაგრებული დისკების ჩვენება"

#: data/pipanel.ui:426
msgid "Show mounted disks on the desktop"
msgstr "მიმაგრებული დისკების ჩვენება სამუშაო მაგიდაზე"

#: data/pipanel.ui:457
msgid "Desktop"
msgstr "სამუშაო მაგიდა"

