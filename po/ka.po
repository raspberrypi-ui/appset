msgid "Taskbar"
msgstr "ამოცანების პანელი"

#: src/pipanel.c:351
msgctxt "tab"
msgid "Theme"
msgstr "თემა"

#: src/pipanel.c:352
msgctxt "tab"
msgid "Defaults"
