msgstr "თაგუნას ურსორის ზომის დაყენება"

#: data/pipanel.ui:874
msgid "Large"
msgstr "დიდი"

#: data/pipanel.ui:875
msgid "Medium"
msgstr "საშუალო"

#: data/pipanel.ui:876
msgid "Small"
msgstr "პატარა"

#: data/pipanel.ui:905
msgid "Theme"
